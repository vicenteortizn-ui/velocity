                  body {
                      background-color: #030303;
                      background-image: radial-gradient(circle at 50% -10%, rgba(242, 201, 76, 0.09), transparent 40%);
                      color: #f3f4f6;
                      letter-spacing: 0.01em;
                  }
                  button, input { touch-action: manipulation; }
                  button { transition: transform .16s ease, background-color .16s ease, opacity .16s ease; }
                  button:active { transform: scale(.97); }
