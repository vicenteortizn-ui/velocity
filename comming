      - name: Compilar APK
        run: gradle assembleDebug --no-daemon

      - name: Preparar APK y codigo QR
        run: |
          cp app/build/outputs/apk/debug/app-debug.apk velocity.apk
          pip install "qrcode[pil]"
          URL="https://github.com/${{ github.repository }}/releases/latest/download/velocity.apk"
          python3 -c "import qrcode,sys; qrcode.make(sys.argv[1]).save('qr.png')" "$URL"
          echo "Enlace de descarga: $URL" >> "$GITHUB_STEP_SUMMARY"

      - name: Publicar descarga
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh release create "v${{ github.run_number }}" velocity.apk qr.png \
            --title "Velocity v${{ github.run_number }}" \
            --notes "Descarga velocity.apk en el celular e instalalo. Tambien puedes escanear qr.png." \
            --latest
